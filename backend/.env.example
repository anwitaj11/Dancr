# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by git, so your keys never get committed.

# Claude, for coach tips and session reports (optional)
ANTHROPIC_API_KEY=

# ElevenLabs: one key for the voice clips AND the Dancr Coach voice agent.
# Create it at elevenlabs.io > Developers > API Keys (give it access to ElevenLabs Agents
# and Text to Speech). Never paste this into frontend code or commit it.
ELEVENLABS_API_KEY=

# Your existing "Dancr Coach" agent (not secret).
ELEVENLABS_AGENT_ID=agent_2601m55mhty9fjcr9eds91nc444r

# Voice for the "5, 6, 7, 8!" clips; matches the coach agent.
ELEVENLABS_VOICE_ID=uYXf8XasLslADfZ2MB4u
